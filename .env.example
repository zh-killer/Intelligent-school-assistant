# ======================
# 智慧校园系统 — 环境变量配置
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# 应用启动时会自动加载 .env 文件（无需手动 export/set）
# ======================

# ---- 智谱AI（必填 — 大模型 + 联网搜索 + 图像识别）----
# 申请地址: https://open.bigmodel.cn/
zhipuai_api_key=你的智谱API密钥
zhipuai_base_url=https://open.bigmodel.cn/api/paas/v4

# ---- 高德地图（推荐 — 天气查询功能需要）----
# 申请地址: https://console.amap.com/ （免费，选"Web服务"）
AMAP_API_KEY=你的高德地图Web服务Key

# ---- MySQL 数据库（推荐 — 登录/历史记录/学生管理需要）----
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码

# ---- QQ邮箱SMTP（可选 — 邮件发送功能）----
# 注意: MAIL_PASS 是SMTP授权码，不是QQ密码
# 获取方式: QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
MAIL_USER=你的QQ邮箱@qq.com
MAIL_PASS=你的QQ邮箱SMTP授权码
MAIL_RECEIVER=收件人邮箱@qq.com
