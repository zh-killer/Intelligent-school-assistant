# ======================
# 智慧校园系统 — 环境变量配置
# 复制此文件为 .env 并填入真实值
# ======================

# 智谱AI（必填 — 大模型 + 联网搜索 + 图像识别）
zhipuai_api_key=你的智谱API密钥
zhipuai_base_url=https://open.bigmodel.cn/api/paas/v4

# 高德地图（必填 — 天气查询）
AMAP_API_KEY=你的高德地图Web服务Key

# MySQL 数据库
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码

# QQ邮箱SMTP（可选 — 邮件发送功能）
MAIL_USER=你的QQ邮箱@qq.com
MAIL_PASS=你的QQ邮箱SMTP授权码
MAIL_RECEIVER=收件人邮箱@qq.com
